            } catch (error) {
                console.warn('Journal indisponible:', error);
                if (journalList) journalList.innerHTML = '<li class="journal-empty">تعذر تحميل السجل حالياً — Journal indisponible pour le moment.</li>';
                setJournalStatus('error');
            }
        }
        loadJournal();

        if (journalForm) {
            journalForm.addEventListener('submit', async (event) => {
                event.preventDefault();
                if (!journalForm.reportValidity()) return;
                if (journalSubmit) journalSubmit.disabled = true;
                if (journalFormStatus) journalFormStatus.textContent = 'جاري الإرسال... — Envoi en cours…';
                try {
                    const response = await fetch('/api/journal', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ nom: journalNom.value.trim(), message: journalMessage.value.trim() })
                    });
                    const data = await response.json().catch(() => ({}));
                    if (!response.ok) throw new Error(data.message || (data.errors && data.errors[0]) || 'HTTP ' + response.status);
                    journalForm.reset();
                    if (journalFormStatus) journalFormStatus.textContent = 'شكراً لك، مساهمتك قيد المراجعة — Merci, votre message est en attente de modération.';
                } catch (error) {
                    if (journalFormStatus) journalFormStatus.textContent = 'تعذر إرسال المساهمة — Envoi impossible : ' + error.message;
                } finally {
                    if (journalSubmit) journalSubmit.disabled = false;
                }
            });
        }

        // ── TOAST ──
        const Toast = Swal.mixin({
            toast: true, position: 'top-end', showConfirmButton: false,
            timer: 3000, timerProgressBar: true
        });
        window.addEventListener('load', () => {
            setTimeout(() => Toast.fire({ icon: 'info', title: 'مرحباً بك في موقع رابطة شباب جدة' }), 1000);
        });

        // ── SCROLL EXPERIENCE : progression, hero parallax et navigation active ──
        const scrollTopBtn = document.getElementById('scrollTop');
        const progressFill = document.querySelector('#pageProgress span');
        const heroHeader = document.getElementById('heroHeader');
        const railLinks = Array.from(document.querySelectorAll('.scroll-rail-link'));
        const trackedSections = ['heroHeader', 'statsSection', 'storySection', 'galerieSection', 'presenceSection', 'evenementsSection', 'villes', 'newsSection', 'structureSection', 'journalSection']
            .map(id => document.getElementById(id)).filter(Boolean);
        let scrollTicking = false;

        function updateScrollExperience() {
            const scrollable = document.documentElement.scrollHeight - window.innerHeight;
            const progress = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
            if (progressFill) progressFill.style.transform = `scaleX(${progress})`;
            if (scrollTopBtn) {
                const showTop = window.scrollY > 420;
                scrollTopBtn.classList.toggle('is-visible', showTop);
            }
            if (heroHeader) {
                const heroHeight = Math.max(heroHeader.offsetHeight, 1);
                const heroProgress = Math.min(Math.max(window.scrollY / heroHeight, 0), 1);
                heroHeader.style.setProperty('--hero-scroll', heroProgress.toFixed(3));
            }
            scrollTicking = false;
        }

        window.addEventListener('scroll', () => {
            if (!scrollTicking) {
                scrollTicking = true;
                requestAnimationFrame(updateScrollExperience);
            }
        }, { passive: true });
        window.addEventListener('resize', updateScrollExperience, { passive: true });
        updateScrollExperience();

        // Chapter progress follows the card crossing the reading line.
        const storyCards = Array.from(document.querySelectorAll('[data-story-step]'));
        const storyCurrent = document.getElementById('storyCurrent');
        const storyProgressFill = document.getElementById('storyProgressFill');
        if ('IntersectionObserver' in window && storyCards.length) {
            const storyObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const step = Number(entry.target.dataset.storyStep) || 1;
                        storyCards.forEach(card => card.classList.toggle('is-current', card === entry.target));
                        entry.target.classList.add('is-seen');
                        if (storyCurrent) storyCurrent.textContent = String(step).padStart(2, '0');
                        if (storyProgressFill) storyProgressFill.style.width = `${(step / storyCards.length) * 100}%`;
                    }
                });
            }, { rootMargin: '-38% 0px -38% 0px', threshold: 0.05 });
            storyCards.forEach(card => storyObserver.observe(card));
        } else {
            storyCards.forEach(card => card.classList.add('is-seen'));
        }

        if ('IntersectionObserver' in window && railLinks.length) {
            const sectionObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (!entry.isIntersecting) return;
                    railLinks.forEach(link => {
                        const active = link.getAttribute('href') === `#${entry.target.id}`;
                        link.classList.toggle('is-active', active);
                        if (active) link.setAttribute('aria-current', 'location');
                        else link.removeAttribute('aria-current');
                    });
                });
            }, { rootMargin: '-38% 0px -48% 0px', threshold: 0 });
            trackedSections.forEach(section => sectionObserver.observe(section));
        }

        // Les liens de navigation mobile reflètent aussi la section ouverte.
        const mobileLinks = Array.from(document.querySelectorAll('#mobileNav a'));
        if ('IntersectionObserver' in window && mobileLinks.length) {
            const mobileSectionObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (!entry.isIntersecting) return;
                    const sectionId = entry.target.id;
                    const href = sectionId === 'newsSection' ? '/nouveautes.html' :
                                 sectionId === 'villes' ? '/membres.html' : '/';
                    mobileLinks.forEach(link => {
                        const active = link.getAttribute('href') === href;
                        link.classList.toggle('active', active);
                    });
                });
            }, { rootMargin: '-35% 0px -55% 0px', threshold: 0 });
            trackedSections.forEach(section => mobileSectionObserver.observe(section));
        }
    </script>
</body>

</html>