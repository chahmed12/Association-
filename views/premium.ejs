                const values = { membres: stats.membres, femmes: stats.femmes, photos: stats.photos };
                if (!statKeys.every((key) => isStatValue(values[key]))) throw new Error('Statistiques incomplètes');
                pendingStats = values;
                setStatsStatus('ready');
                revealStats();
            } catch (e) {
                console.warn('Stats non disponibles', e);
