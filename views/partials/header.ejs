            <h1 class="text-4xl md:text-5xl font-extrabold mb-2 tracking-tight drop-shadow-lg">
                <span class="text-white">رابطة</span>
                <span class="text-green-300">شباب</span>
                <span class="text-white">جدة</span>
            </h1>
            <p class="text-lg font-light text-green-50 animate-pulse">Association de la Jeunesse de Jeddetta</p>
    ...
    </header>
    <main class="container mx-auto px-4 py-12">

    <script>
        // Initialiser AOS
        window.addEventListener('load', () => {
            AOS.init({ duration: 800, once: true });
            const loader = document.getElementById('loader');
            loader.style.opacity = '0';
            setTimeout(() => loader.style.display = 'none', 500);
        });
    </script>

