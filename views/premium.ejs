            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>إدارة</span>
        </a>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.0/vanilla-tilt.min.js"></script>
    <script>
        const prefersReducedMotion = window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)') : { matches: false };
        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: prefersReducedMotion.matches ? 'auto' : 'smooth' });
        }
        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, (char) => {
                if (char === '&') return '&amp;';
                if (char === '<') return '&lt;';
                if (char === '>') return '&gt;';
                if (char === '"') return '&quot;';
                return '&#39;';
            });
        }
        function safeHttpUrl(value, fallback) {
            const raw = String(value ?? '').trim();
            if (!raw) return fallback;
            try {
                const url = new URL(raw, window.location.origin);
                return url.protocol === 'http:' || url.protocol === 'https:' ? url.href : fallback;
            } catch (e) {
                return fallback;
            }
        }
        // ── DARK MODE ──
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        updateDarkToggle(savedTheme);
        updateWaveFill(savedTheme);

        function toggleDark() {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
            updateDarkToggle(next);
            updateWaveFill(next);
        }

        function updateDarkToggle(theme) {
            document.getElementById('darkToggle').textContent = theme === 'dark' ? '☀️' : '🌙';
        }

        function updateWaveFill(theme) {
            const wave = document.getElementById('waveFill');
            if (wave) wave.setAttribute('fill', theme === 'dark' ? '#062c2a' : '#e9d7b4');
        }

        // ── 3D THREE.JS HERO SCENE (MODE TEST) ──
        let threeSceneReady = false;
        let threeRetryCount = 0;
        const THREE_MAX_RETRIES = 30;

        function initThreeScene() {
            if (threeSceneReady) return;
            if (typeof THREE === 'undefined') {
                if (threeRetryCount < THREE_MAX_RETRIES) {
                    threeRetryCount += 1;
                    console.warn('Three.js CDN en cours de chargement... nouvelle tentative dans 100ms');
                    setTimeout(initThreeScene, 100);
                } else {
                    console.error('Three.js indisponible après plusieurs tentatives.');
                }
                return;
            }

            const canvas = document.getElementById('threeCanvas');
            const header = document.getElementById('heroHeader');
            const heroContent = document.getElementById('heroContent');
            const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            let isMobile = window.matchMedia ? window.matchMedia('(max-width: 900px)').matches : window.innerWidth <= 900;
            if (!canvas || !header) {
                console.error('Éléments Three.js canvas ou header introuvables');
                return;
            }

            const width = header.clientWidth || window.innerWidth || 800;
            const height = header.clientHeight || 520;

            console.log('🚀 Initialisation Three.js AJJ 3D :', width, 'x', height);

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            camera.position.set(0, 0, 32);

            let renderer;
            try {
                renderer = new THREE.WebGLRenderer({
                    canvas: canvas,
                    alpha: true,
                    antialias: true,
                    powerPreference: 'high-performance'
                });
                threeSceneReady = true;
            } catch (err) {
                console.error('WebGL non supporté:', err);
                return;
            }

            renderer.setSize(width, height);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, isMobile ? 1.35 : 1.75));

            function makeGlowTexture() {
                const size = 128;
                const glowCanvas = document.createElement('canvas');
                glowCanvas.width = size;
                glowCanvas.height = size;
                const ctx = glowCanvas.getContext('2d');
                const gradient = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
                gradient.addColorStop(0, 'rgba(255,255,255,1)');
                gradient.addColorStop(0.25, 'rgba(255,255,255,0.55)');
                gradient.addColorStop(1, 'rgba(255,255,255,0)');
                ctx.fillStyle = gradient;
                ctx.fillRect(0, 0, size, size);
                return new THREE.CanvasTexture(glowCanvas);
            }

            const glowTexture = makeGlowTexture();

            function makeGlowSprite(color, size, opacity) {
                const sprite = new THREE.Sprite(new THREE.SpriteMaterial({
                    map: glowTexture,
                    color: color,
                    transparent: true,
                    opacity: opacity,
                    blending: THREE.AdditiveBlending,
                    depthWrite: false
                }));
                sprite.scale.set(size, size, 1);
                return sprite;
            }

            const cyanHalo = makeGlowSprite(0x22d3ee, 34, 0.55);
            cyanHalo.position.set(0, 0, -5);
            scene.add(cyanHalo);

            const emeraldHalo = makeGlowSprite(0x10b981, 22, 0.4);
            emeraldHalo.position.set(0, 0, -2);
            scene.add(emeraldHalo);

            const amberHalo = makeGlowSprite(0xfbbf24, 30, 0.22);
            amberHalo.position.set(2, -1, -6);
            scene.add(amberHalo);

            scene.add(new THREE.AmbientLight(0x0f766e, 0.75));

            const keyLight = new THREE.DirectionalLight(0x67e8f9, 1.35);
            keyLight.position.set(8, 10, 14);
            scene.add(keyLight);

            const rimLight = new THREE.PointLight(0xfbbf24, 1.1, 60);
            rimLight.position.set(-10, -6, 8);
            scene.add(rimLight);

            const coreLight = new THREE.PointLight(0x10b981, 1.4, 35);
            coreLight.position.set(0, 0, 6);
            scene.add(coreLight);

            // Groupe pivot principal
            const mainGroup = new THREE.Group();
            scene.add(mainGroup);
            mainGroup.scale.setScalar(isMobile ? 0.76 : 1);
            if (isMobile) camera.position.z = 38;

            const globeSolidGeo = new THREE.IcosahedronGeometry(9.35, 2);
            const globeSolidMat = new THREE.MeshStandardMaterial({
                color: 0x0f766e,
                emissive: 0x042f2e,
                emissiveIntensity: 0.65,
                metalness: 0.35,
                roughness: 0.35,
                flatShading: true,
                transparent: true,
                opacity: 0.55,
                depthWrite: false
            });
            mainGroup.add(new THREE.Mesh(globeSolidGeo, globeSolidMat));

            // 1. Globe Géodésique Connecté (Haute Visibilité)
            const globeGeo = new THREE.IcosahedronGeometry(9.5, 2);
            const globeMat = new THREE.MeshBasicMaterial({
                color: 0x67e8f9, // Cyan lumineux
                wireframe: true,
                transparent: true,
                opacity: 0.5
            });
            const globe = new THREE.Mesh(globeGeo, globeMat);
            mainGroup.add(globe);

            // 2. Sommets lumineux (Points dorés / émeraudes)
            const pointsGeo = new THREE.IcosahedronGeometry(9.5, 2);
            const pointsMat = new THREE.PointsMaterial({
                color: 0xfde047, // Or brillant
                size: 0.65,
                transparent: true,
                opacity: 0.95
            });
            const vertexPoints = new THREE.Points(pointsGeo, pointsMat);
            mainGroup.add(vertexPoints);

            const coreSolidGeo = new THREE.OctahedronGeometry(4.25, 1);
            const coreSolidMat = new THREE.MeshStandardMaterial({
                color: 0x10b981,
                emissive: 0x065f46,
                emissiveIntensity: 1.1,
                metalness: 0.25,
                roughness: 0.2,
                flatShading: true,
                transparent: true,
                opacity: 0.75,
                depthWrite: false
            });
            mainGroup.add(new THREE.Mesh(coreSolidGeo, coreSolidMat));

            // 3. Noyau intérieur rotatif
            const coreGeo = new THREE.OctahedronGeometry(4.5, 1);
            const coreMat = new THREE.MeshBasicMaterial({
                color: 0x10b981, // Émeraude vif
                wireframe: true,
                transparent: true,
                opacity: 0.55
            });
            const coreMesh = new THREE.Mesh(coreGeo, coreMat);
            mainGroup.add(coreMesh);

            // 4. Double anneau d'orbite galactique
            const ringGeo = new THREE.RingGeometry(13.5, 13.8, 64);
            const ringMat = new THREE.MeshBasicMaterial({
                color: 0x34d399,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.5,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });
            const ringMesh = new THREE.Mesh(ringGeo, ringMat);
            ringMesh.rotation.x = Math.PI / 2.8;
            scene.add(ringMesh);

            const ringGeo2 = new THREE.RingGeometry(16, 16.2, 64);
            const ringMat2 = new THREE.MeshBasicMaterial({
                color: 0xfbbf24,
                side: THREE.DoubleSide,
                transparent: true,
                opacity: 0.35,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });
            const ringMesh2 = new THREE.Mesh(ringGeo2, ringMat2);
            ringMesh2.rotation.x = -Math.PI / 3.2;
            ringMesh2.rotation.y = Math.PI / 6;
            scene.add(ringMesh2);

            const ringHighlights = [];

            const ringHighlight = new THREE.Mesh(
                new THREE.RingGeometry(13.45, 13.95, 64, 1, 0, Math.PI * 0.55),
                new THREE.MeshBasicMaterial({
                    color: 0xa7f3d0,
                    side: THREE.DoubleSide,
                    transparent: true,
                    opacity: 0.75,
                    blending: THREE.AdditiveBlending,
                    depthWrite: false
                })
            );
            ringHighlight.rotation.x = ringMesh.rotation.x;
            ringHighlight.rotation.y = ringMesh.rotation.y;
            scene.add(ringHighlight);
            ringHighlights.push(ringHighlight);

            const ringHighlight2 = new THREE.Mesh(
                new THREE.RingGeometry(15.95, 16.45, 64, 1, 0, Math.PI * 0.4),
                new THREE.MeshBasicMaterial({
                    color: 0xfde68a,
                    side: THREE.DoubleSide,
                    transparent: true,
                    opacity: 0.6,
                    blending: THREE.AdditiveBlending,
                    depthWrite: false
                })
            );
            ringHighlight2.rotation.x = ringMesh2.rotation.x;
            ringHighlight2.rotation.y = ringMesh2.rotation.y;
            scene.add(ringHighlight2);
            ringHighlights.push(ringHighlight2);

            // 5. Nuage d'étoiles étincelantes
            const particleCount = reduceMotion ? 70 : (isMobile ? 105 : 240);
            const starGeo = new THREE.BufferGeometry();
            const positions = new Float32Array(particleCount * 3);

            for (let i = 0; i < particleCount * 3; i += 3) {
                const radius = 14 + Math.random() * 18;
                const theta = Math.random() * Math.PI * 2;
                const phi = Math.acos((Math.random() * 2) - 1);
                positions[i] = radius * Math.sin(phi) * Math.cos(theta);
                positions[i + 1] = radius * Math.sin(phi) * Math.sin(theta);
                positions[i + 2] = radius * Math.cos(phi);
            }
            starGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

            const starMat = new THREE.PointsMaterial({
                color: 0xffffff,
                size: 0.35,
                transparent: true,
                opacity: 0.8
            });
            const starField = new THREE.Points(starGeo, starMat);
            scene.add(starField);

            const clock = new THREE.Clock();
            const arcLines = [];
            const nodeSprites = [];

            function latLonToVector3(lat, lon, radius) {
                const phi = (90 - lat) * Math.PI / 180;
                const theta = (lon + 180) * Math.PI / 180;
                return new THREE.Vector3(
                    -radius * Math.sin(phi) * Math.cos(theta),
                    radius * Math.cos(phi),
                    radius * Math.sin(phi) * Math.sin(theta)
                );
            }

            const nodeCoords = [
                [18.1, -15.98],
                [20.9, -17.02],
                [16.5, -15.8],
                [16.15, -13.6],
                [16.6, -11.4],
                [20.5, -13.0],
                [22.7, -12.5]
            ];

            const networkNodes = nodeCoords.map((coords, index) => {
                const node = latLonToVector3(coords[0], coords[1], 9.7);
                const sprite = makeGlowSprite(index === 0 ? 0x67e8f9 : 0xfde047, 2.4, 0.85);
                sprite.position.copy(node);
                mainGroup.add(sprite);
                nodeSprites.push(sprite);
                return node;
            });

            function addArc(start, end, color) {
                const mid = start.clone().add(end).multiplyScalar(0.5).normalize().multiplyScalar(12.4);
                const curve = new THREE.QuadraticBezierCurve3(start, mid, end);
                const geometry = new THREE.BufferGeometry().setFromPoints(curve.getPoints(48));
                const material = new THREE.LineBasicMaterial({
                    color: color,
                    transparent: true,
                    opacity: 0.5,
                    blending: THREE.AdditiveBlending,
                    depthWrite: false
                });
                const line = new THREE.Line(geometry, material);
                mainGroup.add(line);
                arcLines.push(line);
            }

            for (let i = 0; i < networkNodes.length - 1; i += 1) {
                addArc(networkNodes[i], networkNodes[i + 1], 0x67e8f9);
            }
            addArc(networkNodes[0], networkNodes[3], 0xfde047);
            addArc(networkNodes[0], networkNodes[6], 0x34d399);
            addArc(networkNodes[4], networkNodes[6], 0xfbbf24);

            const shootingStars = [];
            if (!reduceMotion) {
                for (let i = 0; i < 3; i += 1) {
                    const shootingGeo = new THREE.BufferGeometry();
                    shootingGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(6), 3));
                    const shootingMat = new THREE.LineBasicMaterial({
                        color: i === 1 ? 0x67e8f9 : 0xffffff,
                        transparent: true,
                        opacity: 0,
                        blending: THREE.AdditiveBlending,
                        depthWrite: false
                    });
                    const shootingLine = new THREE.Line(shootingGeo, shootingMat);
                    shootingLine.frustumCulled = false;
                    scene.add(shootingLine);
                    shootingStars.push({
                        line: shootingLine,
                        offset: [0.05, 0.42, 0.78][i],
                        speed: 0.11 + i * 0.025
                    });
                }
            }

            // 6. Interaction souris/tactile : le geste vertical reste reserve au scroll de la page.
            let mouseX = 0, mouseY = 0;
            let targetX = 0, targetY = 0;
            let isDragging = false;
            let activePointerId = null;
            let prevX = 0, prevY = 0;
            canvas.style.touchAction = 'pan-y';

            function updatePointer(clientX, clientY) {
                const rect = header.getBoundingClientRect();
                mouseX = ((clientX - rect.left) / Math.max(rect.width, 1)) * 2 - 1;
                mouseY = -(((clientY - rect.top) / Math.max(rect.height, 1)) * 2 - 1);
            }

            header.addEventListener('pointermove', (event) => {
                if (event.pointerType === 'mouse' && !isDragging) {
                    updatePointer(event.clientX, event.clientY);
                }
                if (!isDragging || event.pointerId !== activePointerId) return;
                const deltaX = event.clientX - prevX;
                const deltaY = event.clientY - prevY;
                prevX = event.clientX;
                prevY = event.clientY;
                // Only a predominantly horizontal gesture rotates the globe.
                if (Math.abs(deltaX) > Math.abs(deltaY) * 1.15) {
                    mainGroup.rotation.y += deltaX * 0.008;
                }
            }, { passive: true });

            canvas.addEventListener('pointerdown', (event) => {
                if (event.pointerType === 'mouse' && event.button !== 0) return;
                activePointerId = event.pointerId;
                isDragging = true;
                prevX = event.clientX;
                prevY = event.clientY;
            }, { passive: true });

            function stopDragging(event) {
                if (event && activePointerId !== null && event.pointerId !== activePointerId) return;
                isDragging = false;
                activePointerId = null;
            }
            window.addEventListener('pointerup', stopDragging, { passive: true });
            window.addEventListener('pointercancel', stopDragging, { passive: true });
            window.addEventListener('blur', () => stopDragging(), { passive: true });

            // 7. Redimensionnement adapte aux changements d'orientation mobile.
            function handleResize() {
                const w = header.clientWidth || window.innerWidth;
                const h = header.clientHeight || 520;
                isMobile = w <= 900;
                camera.aspect = w / h;
                camera.position.z = isMobile ? 38 : 32;
                mainGroup.scale.setScalar(isMobile ? 0.76 : 1);
                camera.updateProjectionMatrix();
                renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, isMobile ? 1.35 : 1.75));
                renderer.setSize(w, h);
            }
            window.addEventListener('resize', handleResize, { passive: true });

            // 8. Boucle d'animation : pause hors ecran et lorsque l'onglet est masque.
            let isVisible = true;
            let isPageVisible = document.visibilityState !== 'hidden';
            let renderQueued = false;
            function startRender() {
                if (!isVisible || !isPageVisible || renderQueued) return;
                renderQueued = true;
                requestAnimationFrame(render);
            }
            if ('IntersectionObserver' in window) {
                const sceneObserver = new IntersectionObserver((entries) => {
                    isVisible = entries[0].isIntersecting;
                    if (isVisible) startRender();
                }, { threshold: 0.02 });
                sceneObserver.observe(header);
            }
            document.addEventListener('visibilitychange', () => {
                isPageVisible = document.visibilityState !== 'hidden';
                if (isPageVisible) startRender();
            });

            function render() {
                renderQueued = false;
                if (!isVisible || !isPageVisible) return;
                if (!reduceMotion) {
                    renderQueued = true;
                    requestAnimationFrame(render);
                }

                if (!isDragging) {
                    targetX += (mouseX - targetX) * 0.05;
                    targetY += (mouseY - targetY) * 0.05;

                    mainGroup.rotation.y += 0.005;
                    mainGroup.rotation.x = targetY * 0.45;
                    mainGroup.rotation.z = -targetX * 0.25;
                }

                coreMesh.rotation.y -= 0.009;
                coreMesh.rotation.x += 0.006;

                ringMesh.rotation.z += 0.003;
                ringMesh2.rotation.z -= 0.002;
                starField.rotation.y -= 0.0008;

                const elapsed = clock.getElapsedTime();

                if (!reduceMotion) {
                    keyLight.position.x = 8 + Math.sin(elapsed * 0.4) * 4;
                    keyLight.position.y = 10 + Math.cos(elapsed * 0.33) * 3;
                    rimLight.intensity = 0.9 + 0.25 * Math.sin(elapsed * 0.9);
                    coreLight.intensity = 1.2 + 0.35 * Math.sin(elapsed * 1.4);
                    coreSolidMat.emissiveIntensity = 0.95 + 0.25 * Math.sin(elapsed * 1.7);

                    ringHighlights.forEach((highlight, index) => {
                        highlight.rotation.z += index === 0 ? 0.006 : -0.004;
                        highlight.material.opacity = 0.4 + 0.35 * (0.5 + 0.5 * Math.sin(elapsed * 1.3 + index));
                    });

                    camera.position.x = targetX * 0.9;
                    camera.position.y = targetY * 0.55 + Math.sin(elapsed * 0.35) * 0.3;
                    camera.position.z = (isMobile ? 38 : 32) + Math.sin(elapsed * 0.28) * (isMobile ? 0.35 : 0.7);
                    camera.lookAt(0, 0, 0);

                    if (heroContent) {
                        heroContent.style.setProperty('--hero-mouse-x', `${(-targetX * 10).toFixed(2)}px`);
                        heroContent.style.setProperty('--hero-mouse-y', `${(targetY * 8).toFixed(2)}px`);
                    }

                    shootingStars.forEach((star) => {
                        const t = (elapsed * star.speed + star.offset) % 1;
                        const visibility = t < 0.18 ? Math.sin((t / 0.18) * Math.PI) : 0;
                        star.line.material.opacity = visibility * 0.85;

                        const x = 26 - t * 52;
                        const y = 14 - t * 24;
                        const starPositions = star.line.geometry.attributes.position.array;
                        starPositions[0] = x;
                        starPositions[1] = y;
                        starPositions[2] = -18;
                        starPositions[3] = x + 3.2;
                        starPositions[4] = y + 1.8;
                        starPositions[5] = -18;
                        star.line.geometry.attributes.position.needsUpdate = true;
                    });
                }

                arcLines.forEach((line, index) => {
                    line.material.opacity = 0.2 + 0.5 * (0.5 + 0.5 * Math.sin(elapsed * 1.6 + index * 0.7));
                });

                nodeSprites.forEach((sprite, index) => {
                    const pulse = 2.1 + 0.5 * Math.sin(elapsed * 2.4 + index * 0.9);
                    sprite.scale.set(pulse, pulse, 1);
                });

                cyanHalo.material.opacity = 0.45 + 0.12 * Math.sin(elapsed * 0.8);
                emeraldHalo.material.opacity = 0.32 + 0.1 * Math.sin(elapsed * 1.1);

                renderer.render(scene, camera);
            }

            render();
            console.log('✅ Three.js Scène AJJ démarrée avec succès !');
        }

        // Lancement au chargement de la page
        if (document.readyState === 'loading') {
            window.addEventListener('DOMContentLoaded', initThreeScene, { once: true });
        } else {
            initThreeScene();
        }

        // ── VANILLA TILT (Cartes 3D) ──
        // Cartes de navigation
        if (typeof VanillaTilt !== 'undefined' && window.matchMedia('(hover: hover) and (pointer: fine)').matches && window.innerWidth > 900) {
            VanillaTilt.init(document.querySelectorAll("#villes .glass-card"), {
                max: 8,
                speed: 650,
                glare: true,
                "max-glare": 0.16,
                scale: 1.015,
                gyroscope: false
            });
        }

        document.querySelectorAll('.cta-spotlight').forEach((button) => {
            button.addEventListener('mousemove', (event) => {
                const rect = button.getBoundingClientRect();
                button.style.setProperty('--mx', (((event.clientX - rect.left) / rect.width) * 100).toFixed(1) + '%');
                button.style.setProperty('--my', (((event.clientY - rect.top) / rect.height) * 100).toFixed(1) + '%');
            }, { passive: true });
        });

        // ── LOADING BAR ──
        window.addEventListener('load', () => {
            setTimeout(() => {
                document.getElementById('loadingBar').style.opacity = '0';
                setTimeout(() => document.getElementById('loadingBar').remove(), 500);
            }, 800);
        });

        // ── LOGO ──
        const logoImg = document.getElementById('logoImage');
        const logoText = document.getElementById('logoText');

        function showLogo() {
            logoText.classList.add('hidden');
            logoImg.classList.remove('hidden');
        }

        logoImg.onerror = () => { logoImg.classList.add('hidden'); logoText.classList.remove('hidden'); };
        logoImg.onload = showLogo;

        // Correction du bug de cache : Si l'image est DÉJÀ chargée quand le script s'exécute
        if (logoImg.complete && logoImg.naturalWidth > 0) {
            showLogo();
        }

        // ── STATS (counter animation) ──
        const statsSection = document.getElementById('statsSection');
        const statsStatus = document.getElementById('statsStatus');
        const statIds = ['statMembres', 'statFemmes', 'statPhotos'];
        const statKeys = ['membres', 'femmes', 'photos'];
        let statsInView = false;
        let statsAnimated = false;
        let pendingStats = null;

        function isStatValue(value) {
            if (typeof value === 'number') return Number.isFinite(value);
            return typeof value === 'string' && value.trim() !== '' && Number.isFinite(Number(value));
        }

        function setStatsStatus(state) {
            if (!statsStatus) return;
            statsStatus.dataset.state = state;
            const messages = {
                loading: 'جاري تحميل المؤشرات... — Chargement des indicateurs…',
                ready: 'أرقام عامة من بيانات الرابطة — Chiffres publics issus des données de l’association',
                error: 'المؤشرات غير متاحة حالياً — Indicateurs indisponibles pour le moment'
            };
            statsStatus.textContent = messages[state] || '';
        }

        function paintStats(values, animate) {
            statIds.forEach((id, index) => {
                const el = document.getElementById(id);
                if (!el) return;
                const raw = values ? values[statKeys[index]] : undefined;
                if (!isStatValue(raw)) {
                    el.textContent = '—';
                    return;
                }
                if (animate) animateCounter(el, raw);
                else el.textContent = String(Math.floor(Number(raw)));
            });
        }

        function revealStats() {
            if (statsAnimated || !pendingStats) return;
            if (!statsInView && !prefersReducedMotion.matches) return;
            statsAnimated = true;
            paintStats(pendingStats, !prefersReducedMotion.matches);
        }

        if (statsSection && 'IntersectionObserver' in window) {
            const statsObserver = new IntersectionObserver((entries) => {
                if (!entries.some((entry) => entry.isIntersecting)) return;
                statsInView = true;
                statsObserver.disconnect();
                revealStats();
            }, { threshold: 0.25 });
            statsObserver.observe(statsSection);
        } else {
            statsInView = true;
        }

        function animateCounter(el, target, suffix = '') {
            const value = Number(target);
            if (!Number.isFinite(value)) {
                el.textContent = `—${suffix}`;
                return;
            }
            if (prefersReducedMotion.matches) {
                el.textContent = Math.floor(value) + suffix;
                return;
            }
            const duration = 1500;
            const start = performance.now();
            function step(now) {
                const progress = Math.min((now - start) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                el.textContent = Math.floor(eased * value) + suffix;
                if (progress < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
        }

