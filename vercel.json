{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "server.js": {
      "includeFiles": [
        "{views,prive}/**/*",
        "fonts/**/*",
        "public/images/AssociationJJJ.jpg"
      ]
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
