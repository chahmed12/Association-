            .scroll-cue { bottom: 76px; }
            #threeCanvas { opacity: .78; }
            .waves { height: 82px; }
            .story-section { padding: clamp(76px, 10vw, 142px) 22px 0; }
            .story-shell { grid-template-columns: minmax(260px, .78fr) minmax(0, 1.22fr); gap: clamp(34px, 5vw, 80px); width: min(1180px, 100%); }
            .story-intro { position: sticky; top: 15vh; padding: 28px 0 40px; }
            .story-progress { margin-top: 66px; }
            .story-stack { padding: 0 0 18vh; }
            .story-card {
                position: sticky;
                top: calc(10vh + (var(--stack-index) * 15px));
                grid-template-columns: 1.06fr .94fr;
                min-height: clamp(390px, 58vh, 530px);
                margin-bottom: 26px;
                border-radius: 30px;
                transform: translateY(30px) scale(.985);
                opacity: .72;
            }
            .story-card.is-seen { transform: translateY(0) scale(1); opacity: 1; }
            .story-card-copy { padding: clamp(25px, 4vw, 52px); }
            .story-card h3 { margin: 28px 0 12px; font-size: clamp(2rem, 4vw, 3.4rem); }
            .story-card p { max-width: 390px; font-size: 13px; }
            .story-card-tag { margin-top: 27px; }
            .story-art { min-height: 100%; }
            .story-marquee { width: calc(100% + 44px); margin: 95px -22px 0; }
            .presence-grid { grid-template-columns: 1.1fr .9fr; gap: 22px; }
            .presence-map { padding: 20px; border-radius: 28px; }
            .presence-map-frame { max-height: 300px; border-radius: 20px; }
            .events-columns { grid-template-columns: 1.3fr .7fr; gap: 22px; }
            .events-group { padding: 22px; border-radius: 24px; }
            .event-card { padding: 18px; }
            .structure-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
            .structure-card { padding: 22px; border-radius: 24px; }
            .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
            .gallery-thumb img { height: 260px; }
            .gallery-lightbox { padding: 24px; }
            .gallery-dialog img { max-height: 74vh; }
            #galeriePrev { inset-inline-start: -8px; }
            #galerieNext { inset-inline-end: -8px; }
            #galerieClose { top: 12px; inset-inline-end: 12px; }
            #newsContainer { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
            .journal-layout { grid-template-columns: .9fr 1.1fr; gap: 22px; }
            .journal-form, .journal-list-card { padding: 24px; border-radius: 24px; }
            .presence-section, .events-section, .structure-section, .gallery-section, .journal-section { padding-block: 78px; }
            .gallery-section { padding-bottom: 84px; }
        }

        @media (min-width: 1200px) {
            #heroHeader h1 { font-size: 4.8rem; }
            #heroContent { padding-top: 124px; }
            .gallery-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            #villes > div { grid-template-columns: repeat(4, minmax(0, 1fr)) !important; gap: 24px !important; }
            .story-shell { width: min(1240px, 100%); }
        }

        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
            #heroContent, .story-card, .gallery-item, .gallery-item:hover { transform: none !important; }
            .reveal, .story-card { opacity: 1 !important; filter: none !important; }
            .story-art-ring, .story-sun-rays, .story-marquee-track, .animate-shine, .animate-float { animation: none !important; }
        }
        [data-theme="dark"] .glass-card { background: rgba(6,44,42,.86); border-color: rgba(233,215,180,.12); }
        [data-theme="dark"] .event-card { background: rgba(233,215,180,.06); border-color: rgba(233,215,180,.12); }
        [data-theme="dark"] .presence-map-frame { background: #0b3f35; }
        [data-theme="dark"] .text-gradient { background: linear-gradient(135deg, var(--ajj-gold), #9be8c6); -webkit-background-clip: text; background-clip: text; }
